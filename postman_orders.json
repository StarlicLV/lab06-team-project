{
  "info": {
    "name": "Кав'ярня API — Замовлення (Мельник Віталій)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "order_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET список замовлень",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/api/v1/orders",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET список (?status=new)",
      "request": {
        "method": "GET",
        "header": [],
