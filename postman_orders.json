            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": \"a\",\n  \"items\": []\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"є details\", function () { pm.expect(pm.response.json().details).to.be.an(\"object\"); });"
            ]
          }
        }
      ]
    },
