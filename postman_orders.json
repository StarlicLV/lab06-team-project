            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"status = preparing\", function () { pm.expect(pm.response.json().status).to.eql(\"preparing\"); });"
