          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "orders"
          ],
          "query": [
            {
              "key": "status",
              "value": "new"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
