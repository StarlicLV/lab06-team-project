    {
      "name": "POST створити замовлення (з промокодом)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/api/v1/orders",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": 1,\n  \"address\": \"Київ, вул. Хрещатик 1\",\n  \"comment\": \"Без цукру\",\n  \"promo_code\": \"SWEET10\",\n  \"items\": [\n    {\n      \"product_id\": 4,\n      \"quantity\": 2\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201\", function () { pm.response.to.have.status(201); });",
              "var j = pm.response.json(); pm.collectionVariables.set(\"order_id\", j.id); pm.test(\"total = 171\", function () { pm.expect(j.total).to.eql(171); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST без обовʼязкових полів — помилка",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/api/v1/orders",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
